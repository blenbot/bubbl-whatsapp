# Bubbl WhatsApp Server Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=development

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Bubbl Core API (Python server)
BUBBL_CORE_URL=http://localhost:8080

# WhatsApp Configuration
# Browser emulation type: 'Desktop' or 'Web'
BROWSER_TYPE=Desktop
# Whether to sync full message history on connect
SYNC_FULL_HISTORY=true

# Rate Limiting (messages per minute)
RATE_LIMIT_PER_MINUTE=30

# Logging
LOG_LEVEL=info
